#!/usr/bin/env bash
###############################################################################
# morpheus - single entry point for the whole pipeline, or any part of it.
#
#   morpheus run --gene MX1                    # one gene, here
#   morpheus run --gene_list genes.txt         # many genes, here
#   morpheus run --path_file paths.txt --mode slurm   # submit the whole chain
#   morpheus run --search region --skip_plot   # locus only, tables only
#   morpheus run --from assign                 # resume from a step
#   morpheus run --dry-run                     # print the plan and stop
#   morpheus step bat-search --help            # the Python CLI, for one step
#   morpheus plot exon-models --gene MX1
#   morpheus env                               # show what was resolved
#
# The package works from a git checkout with no installation: this script finds
# its own directory, so `bin/morpheus` and `/path/to/Morpheus/bin/morpheus`
# behave identically.
###############################################################################
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MORPHEUS_HOME="$(cd "${here}/.." && pwd)"
export MORPHEUS_HOME

# A heredoc, not `sed -n 'M,Np'` over this file's own comment block: that range
# silently drifts every time a comment is added above it, and starts printing
# shell source at the user.
usage() {
    cat <<'EOF'
morpheus - comparative transcript recovery, orthologous transcript assignment
           and gene copy number across TOGA2-annotated genomes.

USAGE
  morpheus <command> [options]

COMMANDS
  run [options]        run the pipeline, or any part of it
  env                  show what was resolved, and what is missing
  step NAME [options]  run one step through the Python CLI
  plot NAME [options]  redraw one figure
                         exon-models | transcript-status | scope-comparison
                         | copy-number
  version              print the version
  help                 this message

FIRST RUN
  1. Tell Morpheus where your data is. Make a paths.txt:

       human_genome_dir=/data/reference/human
       bat_annotation_dir=/data/toga2/bat1k
       primary_working_dir=/scratch/me/isg_project

     (a ready-to-edit copy is in examples/paths.txt)

  2. Make a gene_list.txt, one gene symbol per line:

       MX1
       OAS1
       IFITM3

  3. Check it found everything. This never runs an analysis:

       morpheus env
       morpheus run --gene_list gene_list.txt --dry-run

  4. Run it:

       morpheus run --gene_list gene_list.txt

EXAMPLES
  # one gene, reading paths.txt from the current directory
  morpheus run --gene OAS1

  # a whole list, on a cluster: submits four dependent jobs and returns
  morpheus run --gene_list gene_list.txt --path_file paths.txt \
      --mode slurm --slurm_partition compute

  # no paths.txt; say where everything is on the command line
  morpheus run --gene_list gene_list.txt \
      --ref_dir /data/reference/human \
      --bat_dir /data/toga2/bat1k \
      --tree    /data/reference/bat1k_tree.nwk \
      --output  /scratch/me/isg_project

  # syntenic locus only, tables but no figures - about half the work
  morpheus run --gene_list gene_list.txt --search region --skip_plot

  # something failed at the assignment step; pick up from there
  morpheus run --gene_list gene_list.txt --from assign

  # redraw one gene's exon models after the fact
  morpheus plot exon-models --gene MX1

WHERE THE RESULTS GO
  <output>/results/01_human_reference   ... 06_plots
  <output>/results/SUMMARY__<ranking>.md      <- start here

  morpheus run --help    every flag, in full
  README.md              what each step actually does, and why
EOF
}

# --------------------------------------------------------------------------
# environment
# --------------------------------------------------------------------------
activate_environment() {
    # Already inside it? Leave well alone; a site may have its own module.
    if [[ "${CONDA_DEFAULT_ENV:-}" == "${MORPHEUS_ENV:-Morpheus}" ]]; then
        return 0
    fi
    # A site module system (Apocrita: `ml miniforge`) may already have put the
    # tools on PATH without a named conda env. Accept that.
    if command -v mafft >/dev/null 2>&1 && command -v blastx >/dev/null 2>&1; then
        return 0
    fi

    local env_name="${MORPHEUS_ENV:-Morpheus}"
    local root="${MORPHEUS_CONDA_ROOT:-}"
    if [[ -z "${root}" ]]; then
        for candidate in "${CONDA_PREFIX_1:-}" "${CONDA_PREFIX:-}" \
                         "${HOME}/miniforge3" "${HOME}/mambaforge" \
                         "${HOME}/miniconda3" "${HOME}/anaconda3" \
                         "${HOME}/Downloads/miniconda3" "/opt/miniconda3"; do
            [[ -n "${candidate}" && -d "${candidate}/envs/${env_name}" ]] && { root="${candidate}"; break; }
        done
    fi
    if [[ -n "${root}" && -d "${root}/envs/${env_name}" ]]; then
        export PATH="${root}/envs/${env_name}/bin:${PATH}"
        export CONDA_PREFIX="${root}/envs/${env_name}"
        export CONDA_DEFAULT_ENV="${env_name}"
        return 0
    fi
    return 1
}

python_bin() { command -v python3 || command -v python; }

cmd_env() {
    activate_environment || true
    cat <<EOF
Morpheus $(cat "${MORPHEUS_HOME}/VERSION" 2>/dev/null || echo "unknown")
  home            ${MORPHEUS_HOME}
  environment     ${CONDA_DEFAULT_ENV:-<none active>}
  python          $(python_bin 2>/dev/null || echo MISSING)
EOF
    local missing=0
    for exe in python3 blastx blastp makeblastdb mafft Rscript; do
        if command -v "$exe" >/dev/null 2>&1; then
            printf '  %-14s %s\n' "$exe" "$(command -v "$exe")"
        else
            printf '  %-14s MISSING\n' "$exe"; missing=1
        fi
    done
    if command -v Rscript >/dev/null 2>&1; then
        Rscript -e 'for (p in c("ape","ggplot2","paletteer")) cat(sprintf("  R:%-12s %s\n", p, requireNamespace(p, quietly=TRUE)))' 2>/dev/null
    fi

    # Resolving the inputs is the half people actually get wrong, so show what
    # paths.txt and the defaults produced, and whether each thing is there.
    # A subshell, so a bad paths.txt is reported rather than killing this.
    echo
    (
        set +u
        # shellcheck disable=SC1091
        if ! source "${MORPHEUS_HOME}/config/config.sh"; then
            echo "Inputs: config could not be loaded (see the error above)"
            exit 0
        fi
        echo "Inputs resolved from ${PATHS_FILE}:"
        _show() {  # label, path, d|f
            local mark="MISSING"
            [[ "$3" == "d" && -d "$2" ]] && mark="ok"
            [[ "$3" == "f" && -s "$2" ]] && mark="ok"
            printf '  %-12s %-8s %s\n' "$1" "${mark}" "${2:-<unset>}"
        }
        _show "paths.txt" "${PATHS_FILE}"         f
        _show "bat_dir"   "${BAT_ANNOTATION_DIR}" d
        _show "ref_dir"   "${HUMAN_GENOME_DIR}"   d
        _show "output"    "${WORKING_DIR}"        d
        _show "tree"      "${SPECIES_TREE}"       f
        _show "gene_list" "${GENE_LIST}"          f
        _show "human GTF" "${HUMAN_GTF}"          f
        _show "human CDS" "${HUMAN_CDS_FASTA}"    f
        printf '  %-12s %-8s %s\n' "results" "->" "${RESULTS_DIR}"
    )

    [[ $missing -eq 0 ]] || echo "
Some tools are missing. Run: bash install.sh"
    return 0
}

# --------------------------------------------------------------------------
# dispatch
# --------------------------------------------------------------------------
sub="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "${sub}" in
    run)
        activate_environment || true
        exec bash "${MORPHEUS_HOME}/scripts/run_pipeline.sh" "$@"
        ;;
    step)
        activate_environment || true
        export PYTHONPATH="${MORPHEUS_HOME}${PYTHONPATH:+:${PYTHONPATH}}"
        exec "$(python_bin)" -m morpheus "$@"
        ;;
    plot)
        activate_environment || true
        name="${1:?usage: morpheus plot NAME [options]}"; shift || true
        case "${name}" in
            exon-models|exon_models)          script=plot_exon_models.R ;;
            transcript-status|status)         script=plot_transcript_status.R ;;
            scope-comparison|scope)           script=plot_scope_comparison.R ;;
            copy-number|copy_number|cnv)      script=plot_copy_number.R ;;
            *) echo "unknown figure '${name}'" >&2; exit 2 ;;
        esac
        exec Rscript "${MORPHEUS_HOME}/R/${script}" "$@"
        ;;
    env)      cmd_env ;;
    version)  cat "${MORPHEUS_HOME}/VERSION" ;;
    help|-h|--help) usage ;;
    *) echo "unknown command '${sub}'" >&2; usage >&2; exit 2 ;;
esac
